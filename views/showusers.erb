<h1>Users</h1>
<h2>All users list</h2>

<table class="table table-striped">

  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Phone</th>
      <th>Datestamp</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
    <tr>
      <td><%= user['id'] %></td>
      <td><%= user['name'] %></td>
      <td><%= user['phone'] %></td>
      <td><%= user['datestamp'] %></td>
    <% end %>
  </tbody>

</table>

